# Secrets — never push
.env

# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Vector store runtime data (re-built on startup)
vector_store/*
!vector_store/.gitkeep

# Scraped job dumps (runtime artifacts)
data/scraped_jobs_*.json

# Build artifacts
dist/
build/

# OS junk
.DS_Store
Thumbs.db
